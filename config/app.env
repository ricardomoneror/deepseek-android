# DeepSeek for Android — application identity & SDK floor/ceiling.
# Consumed ONLY via build/tools/gen_android_config.py ->
#   res/values/gen.xml  +  com/ds/ide/BuildConfig.java
# and via build/lib/paths.sh for aapt --min-sdk-version / --target-sdk-version.
# Never hardcode these in AndroidManifest.xml or Java sources.
#
# NOTE: Both PKG (com.ds.ide) and PKG_DEV (com.ds.dev) are 10 ASCII bytes exact
# (matching len("com.termux") == 10), enabling zero-PRoot in-place ELF prefix
# rewriting across glibc (resolv.conf/nsswitch.conf), node.elf, dpkg, bash, rg, and Bionic shared libs.

PKG=com.ds.ide
PKG_DEV=com.ds.dev
APP_NAME=DeepSeek
APP_NAME_DEV=DeepSeek Dev
VERSION_CODE=20320
VERSION_NAME=0.2.2-r12
CORE_VERSION=0.2.2-rc.3
PORT=45187
PORT_DEV=45188
OAUTH_SCHEME=deepseek

# TARGET_SDK=28 MUST stay <= 28 so Android 10-16+ allows execve() directly from
# getFilesDir()/runtime/bin/* and getFilesDir()/usr/bin/* without W^X SELinux blocks.
MIN_API=28
TARGET_SDK=28
